# For advice on how to change settings please see
# http://dev.mysql.com/doc/refman/8.4/en/server-configuration-defaults.html

[mysqld]
#
# Remove leading # and set to the amount of RAM for the most important data
# cache in MySQL. Start at 70% of total RAM for dedicated server, else 10%.
innodb_buffer_pool_size = 128M
#
# Remove leading # to turn on a very important data integrity option: logging
# changes to the binary log between backups.
# log_bin
#
# Remove leading # to set options mainly useful for reporting servers.
# The server defaults are faster for transactions and fast SELECTs.
# Adjust sizes as needed, experiment to find the optimal values.
# join_buffer_size = 128M
# sort_buffer_size = 2M
# read_rnd_buffer_size = 2M

host-cache-size=0
skip-name-resolve
datadir=/var/lib/mysql
socket=/var/run/mysqld/mysqld.sock
secure-file-priv=/var/lib/mysql-files
user=mysql

default-time-zone='Europe/Moscow'

pid-file=/var/run/mysqld/mysqld.pid

# Количество экземпляров буферного пула (для больших объемов памяти)
# Рекомендуется 1 экземпляр на каждые 1-2 ГБ buffer pool, но не более 8-16
# innodb_buffer_pool_instances = 4

# Емкость ввода-вывода (IOPS) для фоновых операций (по умолчанию 10000 для SSD)
# Для NVMe можно увеличить, для HDD — уменьшить
# innodb_io_capacity = 10000

# Количество фоновых потоков для чтения и записи
# По умолчанию: read = (кол-во логических процессоров / 2, но не менее 4), write = 4
# innodb_read_io_threads = 4
# innodb_write_io_threads = 4

# Общая емкость журнала повторного выполнения (redo log)
# Увеличение сглаживает пиковые нагрузки на запись
innodb_redo_log_capacity = 2G

# Размер буфера журнала (для больших транзакций)
innodb_log_buffer_size = 64M

#
# Дополнительные настройки
#
# Отключение буферизации изменений (в MySQL 8.4 по умолчанию выключено для стабильности)
# innodb_change_buffering = none

# Адаптивный хеш-индекс (можно отключить, если наблюдаются накладные расходы)
# innodb_adaptive_hash_index = OFF

#
# Настройки для повышения стабильности и производительности в контейнере
#
# Использование O_DIRECT для избежания двойного кэширования (по умолчанию в 8.4)
# innodb_flush_method = O_DIRECT

# Отключение двойной записи (только для тестовых сред! Риск потери данных при сбое)
# innodb_doublewrite = OFF

[client]
socket=/var/run/mysqld/mysqld.sock

!includedir /etc/mysql/conf.d/
